# ============================================
# 可选配置 - GitHub OAuth 登录功能
# ============================================
# 如果需要启用用户登录功能，请配置以下三项
# 获取方式: https://github.com/settings/developers
# G_CLIENT_ID=your_github_client_id
# G_CLIENT_SECRET=your_github_client_secret
# JWT_SECRET=生成的随机密钥（可用: openssl rand -base64 32）

# ============================================
# 可选配置 - AI 功能
# ============================================
# Anthropic Claude API Key（用于 AI 聊天等功能）
# 获取方式: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================
# 可选配置 - Product Hunt API
# ============================================
# PRODUCTHUNT_API_TOKEN=

# ============================================
# 情感共鸣筛选配置
# ============================================
# 启用筛选功能（默认：false）
ENABLE_EMOTIONAL_FILTER=true

# 启用筛选的数据源（逗号分隔，'*'表示所有）
FILTER_ENABLED_SOURCES=*,zhihu,weibo,douban

# 批量处理大小（默认：5）
FILTER_BATCH_SIZE=5

# 缓存TTL（毫秒，默认：24小时）
FILTER_CACHE_TTL=86400000

# 是否生成卡片摘要（默认：true）
GENERATE_CARD_SNIPPETS=true

# ============================================
# 数据库配置
# ============================================
INIT_TABLE=true
ENABLE_CACHE=true
